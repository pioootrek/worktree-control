{
  "name": "worktree-switcher",
  "version": "0.1.0-trial.1",
  "private": true,
  "description": "Switch development servers between Git worktrees without changing ports",
  "license": "MIT",
  "author": "pioootrek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pioootrek/worktree-switcher.git"
  },
  "homepage": "https://github.com/pioootrek/worktree-switcher#readme",
  "bugs": {
    "url": "https://github.com/pioootrek/worktree-switcher/issues"
  },
  "type": "module",
  "bin": {
    "worktree-switcher": "dist/cli/index.js"
  },
  "files": [
    "dist/cli",
    "out",
    "skills",
    "docs/authentication.md",
    "docs/controller-https.md",
    "docs/dependency-licenses.md",
    "docs/package-trial.md",
    "docs/user-service.md",
    "docs/reservations-and-mcp.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build && tsup src/cli/index.ts src/cli/backup-verifier.ts --format esm --platform node --target node22 --clean --out-dir dist/cli && node scripts/build-fingerprint.mjs --write",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:resources",
    "dev": "node scripts/dev-controller.mjs",
    "dev:web": "next dev",
    "lint": "eslint .",
    "package:trial": "node scripts/package-trial.mjs",
    "start": "node dist/cli/index.js start",
    "smoke:package": "node scripts/package-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:modules": "vitest run src/server/modules src/server/infrastructure src/architecture.test.ts",
    "test:ui": "playwright test",
    "test:ui:detail-focus": "playwright test tests/ui/detail-focus.spec.ts",
    "test:integration": "node scripts/build-fingerprint.mjs --check && vitest run --config vitest.integration.config.ts",
    "test:https": "node scripts/build-fingerprint.mjs --check && vitest run --config vitest.https.config.ts",
    "test:e2e": "node scripts/build-fingerprint.mjs --check && playwright test --config playwright.e2e.config.ts",
    "bench:resources": "node scripts/resource-benchmark.mjs",
    "test:resources": "node --test scripts/*.test.mjs",
    "test:sqlite-cost": "tsx scripts/sqlite-write-cost.ts",
    "test:backups": "vitest run src/server/modules/backups src/cli/backup-policy-options.test.ts src/server/backup-admin.test.ts src/server/transports/backup-http.test.ts src/server/control-service-storage.test.ts",
    "test:ui:backups": "playwright test tests/ui/backups.spec.ts",
    "test:integration:backups": "node scripts/build-fingerprint.mjs --check && vitest run --config vitest.integration.config.ts tests/integration/backup-operations.test.ts",
    "test:user-backups": "vitest run src/server/modules/backups/user-schedules.test.ts src/server/modules/backups/user-export-crash.test.ts src/cli/user-backup-options.test.ts src/server/transports/user-backup-http.test.ts src/server/modules/backups/user-export-recovery.test.ts src/cli/user-export-recovery.test.ts",
    "test:ui:user-backups": "playwright test tests/ui/user-backups.spec.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
